<!DOCTYPE html>
<html lang="{% if language == 'en' %}en-GB{% else %}ko-KR{% endif %}">

<head>
  <meta name="naver-site-verification" content="610d8f78982480256940c50a3bdab452e49633f1" />
  <meta charset="utf-8">
  <title>{{ seo_title }}</title>
  <meta content="{{ seo_description }}" name="description">
  <meta content="{{ seo_title }}" property="og:title">
  <meta content="{{ seo_description }}" property="og:description">
  <meta content="{{ seo_title }}" property="twitter:title">
  <meta content="{{ seo_description }}" property="twitter:description">
  <meta property="og:type" content="article">
  <meta content="summary_large_image" name="twitter:card">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <link rel="canonical" href="https://imin2uk.com/{{ slug }}/">
  {% if no_ko_page %}
  {# 한국어 대응 페이지 없음 — en만 선언, x-default도 자기 자신 #}
  <link rel="alternate" hreflang="en" href="https://imin2uk.com/{{ slug }}/">
  <link rel="alternate" hreflang="x-default" href="https://imin2uk.com/{{ slug }}/">
  {% elif no_en_page %}
  {# 영어 대응 페이지 없음 — ko만 선언, x-default도 자기 자신 #}
  <link rel="alternate" hreflang="ko" href="https://imin2uk.com/{{ slug }}/">
  <link rel="alternate" hreflang="x-default" href="https://imin2uk.com/{{ slug }}/">
  {% else %}
  {# 한국어·영어 양쪽 존재 — 대칭 hreflang 선언 #}
  <link rel="alternate" hreflang="ko" href="https://imin2uk.com/{{ slug | replace('-en', '') }}/">
  <link rel="alternate" hreflang="en" href="https://imin2uk.com/{% if language == 'en' %}{{ slug }}{% else %}{{ slug }}-en{% endif %}/">
  <link rel="alternate" hreflang="x-default" href="https://imin2uk.com/{{ slug | replace('-en', '') }}/">
  {% endif %}
  <meta property="og:url" content="https://imin2uk.com/{{ slug }}/">
  <meta property="og:locale" content="{% if language == 'en' %}en_GB{% else %}ko_KR{% endif %}">
  <meta property="og:locale:alternate" content="{% if language == 'en' %}ko_KR{% else %}en_GB{% endif %}">
  <meta property="og:site_name" content="Imin2UK">
  <meta property="og:logo" content="https://imin2uk.com/images/Imin2UK_Logo_250802.svg">
  {# og:type article — 위 line 13에서 이미 선언됨, 중복 제거 #}
  <meta property="og:image" content="https://imin2uk.com/{% if og_image %}{{ og_image }}{% else %}images/Imin2UK-home-intro2.webp{% endif %}">
  <meta property="twitter:image" content="https://imin2uk.com/{% if og_image %}{{ og_image }}{% else %}images/Imin2UK-home-intro2.webp{% endif %}">
  <link href="/css/main.css" rel="stylesheet" type="text/css">
  <script
    type="text/javascript">!function (o, c) { var n = c.documentElement, t = " w-mod-"; n.className += t + "js", ("ontouchstart" in o || o.DocumentTouch && c instanceof DocumentTouch) && (n.className += t + "touch") }(window, document);</script>
  <link href="/images/favicon.png" rel="shortcut icon" type="image/x-icon">
  <link href="/images/webclip.png" rel="apple-touch-icon">
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ h1 }}",
  "name": "{{ title }}",
  "description": "{{ seo_description }}",
  "url": "https://imin2uk.com/{{ slug }}/",
  "datePublished": "{{ date }}",
  "inLanguage": "{% if language == 'en' %}en-GB{% else %}ko-KR{% endif %}",
  "author": {
    "@type": "Organization",
    "name": "Imin2UK Ltd"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Imin2UK Ltd",
    "logo": {
      "@type": "ImageObject",
      "url": "https://imin2uk.com/images/Imin2UK_Logo_250802.svg"
    }
  }
}
</script>
</head>

<body>
  <div class="page-wrapper">
    {% if language == 'en' %}
      {% include "header-en.njk" %}
    {% else %}
      {% include "header.njk" %}
    {% endif %}

    <main class="main-wrapper">
      <div class="post-hero">
        <div class="padding-global">
          <div class="container-medium">
            <div class="spacer-large"></div>
            <h1 class="heading-style-h1 is-blog-heading">{{ h1 }}</h1>
            <div class="blog-post-meta">
              {% if language == 'en' %}
                <time class="blog-post-date" datetime="{{ date | date('YYYY-MM-DD') }}">
                  {{ date | date('DD-MM-YYYY HH:mm') }}
                </time>
              {% else %}
                <time class="blog-post-date" datetime="{{ date | date('YYYY-MM-DD') }}">
                  {{ date | date('YYYY-MM-DD HH:mm') }}
                </time>
              {% endif %}
            </div>
            <div class="spacer-large"></div>
          </div>
        </div>
      </div>
      <div class="section-article">
        <div class="padding-global">
          <div class="container-medium">
            <div class="blog-body w-richtext">
              {{ content | safe }}
            </div>
            <div class="spacer-large"></div>
            {% if tags and tags.length %}
            <div class="blog-tag-cloud">
              <div class="blog-tag-cloud-label">{% if language == 'en' %}Tags{% else %}태그{% endif %}</div>
              <div class="blog-tag-list">
                {% for tag in tags %}
                <span class="blog-tag">{{ tag }}</span>
                {% endfor %}
              </div>
            </div>
            {% endif %}
            <div class="spacer-large"></div>
          </div>
        </div>
      </div>
    </main>

    {% if language == 'en' %}
      {% include "footer-en.njk" %}
    {% else %}
      {% include "footer.njk" %}
    {% endif %}
  </div>

  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=69679bea10b420b922099e64"
    type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
    crossorigin="anonymous" defer></script>
  <script src="/js/webflow.js" type="text/javascript" defer></script>
  <script src="/js/common.js" type="text/javascript" defer></script>
</body>
</html>
