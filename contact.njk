  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=69679bea10b420b922099e64"
    type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
    crossorigin="anonymous"></script>
  <script src="js/webflow.js" type="text/javascript"></script>
  <script src="js/common.js" type="text/javascript"></script>
  <script src="https://js.hcaptcha.com/1/api.js?hl=ko" async defer></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const form = document.getElementById("email-form");
      if (!form) return;

      form.addEventListener("submit", function (e) {
        e.preventDefault();

        // 1. hCaptcha 체크 검증
        const hcaptchaResponse = form.querySelector('[name="h-captcha-response"]');
        const captchaError = document.getElementById("captcha-error");
        
        if (!hcaptchaResponse || hcaptchaResponse.value.trim() === "") {
          if (captchaError) captchaError.style.display = "block";
          return;
        } else {
          if (captchaError) captchaError.style.display = "none";
        }

        // 2. FormData 객체 생성
        const formData = new FormData(form);
        const submitBtn = form.querySelector('input[type="submit"]');
        const originalBtnText = submitBtn.value;
        const waitText = submitBtn.getAttribute("data-wait") || "Please wait...";

        // 버튼 상태 변경
        submitBtn.value = waitText;
        submitBtn.disabled = true;

        // 3. fetch로 Web3Forms에 전송
        fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData
        })
        .then(async (response) => {
          if (response.status === 200) {
            // 성공 로직
            form.reset();
            if (typeof hcaptcha !== "undefined") {
              hcaptcha.reset();
            }
            
            // 폼 래퍼 내부에서 요소 찾기
            const parent = form.parentNode;
            
            // 기본 폼 숨기기
            form.style.display = "none";
            
            // 성공 메시지 표시
            const successDiv = parent.querySelector('.w-form-done');
            if (successDiv) {
              successDiv.style.display = "block";
            }
          } else {
            // 에러 처리
            const parent = form.parentNode;
            const errorDiv = parent.querySelector('.w-form-fail');
            if (errorDiv) {
              errorDiv.style.display = "block";
            }
          }
        })
        .catch((error) => {
          console.error("Submission Error:", error);
          const parent = form.parentNode;
          const errorDiv = parent.querySelector('.w-form-fail');
          if (errorDiv) {
            errorDiv.style.display = "block";
          }
        })
        .finally(() => {
          submitBtn.value = originalBtnText;
          submitBtn.disabled = false;
        });
      });
    });
  </script>
</body>

</html>
