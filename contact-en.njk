<!DOCTYPE html>
<html lang="en-GB">

<head>
  <meta charset="utf-8">
  <title>Contact | Imin2UK</title>
  <meta content="Contact Imin2UK, the UK immigration experts. Get visa advice via phone, email, or WhatsApp. Operating Monday to Friday, 9am to 5pm UK time."
    name="description">
  <meta content="Contact | Imin2UK" property="og:title">
  <meta content="Contact Imin2UK, the UK immigration experts. Get visa advice via phone, email, or WhatsApp. Operating Monday to Friday, 9am to 5pm UK time."
    property="og:description">
  <meta content="Contact | Imin2UK" property="twitter:title">
  <meta content="Contact Imin2UK, the UK immigration experts. Get visa advice via phone, email, or WhatsApp. Operating Monday to Friday, 9am to 5pm UK time."
    property="twitter:description">
  <meta property="og:type" content="website">
  <meta content="summary_large_image" name="twitter:card">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <link href="css/normalize.css" rel="stylesheet" type="text/css">
  <link href="css/webflow.css" rel="stylesheet" type="text/css">
  <link href="css/wordpress-clone-imin2uk.webflow.css" rel="stylesheet" type="text/css">
  <script src="js/webflow-init.js" type="text/javascript"></script>
  <link href="images/favicon.png" rel="shortcut icon" type="image/x-icon">
  <link href="images/webclip.png" rel="apple-touch-icon">
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact us",
  "url": "https://imin2uk.com/contact-en",
  "inLanguage": "en-GB",
  "about": {
    "@type": "Organization",
    "name": "Imin2UK Ltd",
    "url": "https://imin2uk.com/home-en",
    "logo": {
      "@type": "ImageObject",
      "url": "https://imin2uk.com/images/Imin2UK_Logo_250802.svg"
    },
    "identifier": "10618691",
    "email": "info@imin2uk.com",
    "telephone": "+44 0203 916 5493",
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "telephone": "+44 0203 916 5493",
        "contactType": "customer service",
        "availableLanguage": [
          "en",
          "ko"
        ],
        "hoursAvailable": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"
          ],
          "opens": "09:00",
          "closes": "17:00"
        }
      },
      {
        "@type": "ContactPoint",
        "telephone": "+44 0749 3700 551",
        "contactType": "customer service",
        "contactOption": "TollFree",
        "availableLanguage": [
          "en",
          "ko"
        ]
      }
    ]
  }
}
</script>
  <link href="css/common.css" rel="stylesheet" type="text/css">
</head>

<body>
  <div class="page-wrapper">
    {% include "header-en.njk" %}
    <main class="main-wrapper">
      <div id="section_home_intro" class="section-article">
        <div class="padding-global">
          <div class="container-large">
            <div class="spacer-large"></div>
            <div class="spacer-large"></div>
            <div class="contact-heading-block">
              <div class="text-size-medium is-text-red">If you have any questions about UK visas,<br></div>
              <div class="spacer-small"></div>
              <div class="heading-style-h1 is-contact-h1">Feel free to contact us!<br></div>
            </div>
            <div class="spacer-large"></div>
            <div class="contact-grid">
              <div class="contact-form-wrapper">
                <div class="w-form">
                  <form id="email-form" name="email-form" data-name="Email Form" action="https://api.web3forms.com/submit" method="POST" class="contact-block">
                    <input type="hidden" name="access_key" value="c6b2f428-3c70-4475-9ccb-f90a2c500d2b">
                    <input type="hidden" name="subject" value="[English Inquiry] New submission from website.">
                    <label for="name" class="contact-sub-heading">Name</label>
                    <input class="text-field is-contact-form w-input" maxlength="256" name="name" data-name="Name" placeholder="" type="text" id="name">
                    <div class="spacer-small"></div>
                    <label for="email" class="contact-sub-heading">Email Address</label>
                    <input class="text-field is-contact-form w-input" maxlength="256" name="email" data-name="Email" placeholder="" type="email" id="email" required="">
                    <div class="spacer-small"></div>
                    <label for="Message" class="contact-sub-heading">Enquiry</label>
                    <textarea placeholder="Example Text" maxlength="5000" id="Message" name="Message" data-name="Message" class="textarea w-input" required=""></textarea>
                    <div class="spacer-small"></div>
                    <div class="h-captcha" data-captcha="true"></div>
                    <input type="submit" data-wait="Please wait..." class="button is-brand w-button" value="Submit">
                  </form>
                  <div class="success-message w-form-done">
                    <div>Thank you! Your submission has been received!</div>
                  </div>
                  <div class="w-form-fail">
                    <div>Oops! Something went wrong while submitting the form.</div>
                  </div>
                </div>
              </div>
              <div class="contact-block-wrapper">
                <div class="contact-block">
                  <div class="contact-sub-heading">Telephone (UK business hours: 9am – 5pm)</div>
                  <div class="text-size-large text-weight-bold">0203 916 5493<br></div>
                </div>
                <div class="contact-block">
                  <div class="contact-sub-heading">When calling from outside the UK</div>
                  <div class="text-size-large text-weight-bold">+44 203 916 5493<br></div>
                  <div class="text-size-medium">If unable to get through due to the time difference,<br></div>
                  <div class="text-size-medium">please leave a message with your contact details.<br></div>
                </div>
                <div class="contact-block">
                  <div class="contact-sub-heading">Email</div>
                  <div class="text-size-large">info@imin2uk.com<br></div>
                </div>
                <div class="contact-block">
                  <div class="contact-sub-heading">WhatsApp</div>
                  <div class="text-size-medium">Add +44 0749 3700 551<br></div>
                  <div class="text-size-medium">Or scan the QR code below<br></div><img
                    src="images/WhatsApp_QR2-300x300.png" loading="lazy" alt="WhatsApp QR Code"
                    class="contact-qr-image">
                </div>
                <div class="contact-block">
                  <div class="contact-sub-heading">Address</div>
                  <div class="text-size-medium">Imin2UK Ltd, 7 Bell Yard, London, WC2A 2JR, United Kingdom<br></div>
                </div>
              </div>
            </div>
          </div>
          <div class="spacer-large"></div>
          <div class="spacer-large"></div>
        </div>
      </div>
    </main>
    {% include "footer-en.njk" %}
  </div>

  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=69679bea10b420b922099e64"
    type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
    crossorigin="anonymous"></script>
  <script src="js/webflow.js" type="text/javascript"></script>
  <script src="js/common.js" type="text/javascript"></script>
  <script src="https://web3forms.com/client/script.js" async defer></script>
</body>

</html>
