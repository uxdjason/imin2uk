<!DOCTYPE html>
<html lang="ko-KR" id="html-root">

<head>
  <meta charset="utf-8">
  <title>Not Found</title>
  <meta content="Not Found" property="og:title">
  <meta content="Not Found" property="twitter:title">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <link href="css/normalize.css" rel="stylesheet" type="text/css">
  <link href="css/webflow.css" rel="stylesheet" type="text/css">
  <link href="css/wordpress-clone-imin2uk.webflow.css" rel="stylesheet" type="text/css">
  <script src="js/webflow-init.js" type="text/javascript"></script>
  <link href="images/favicon.png" rel="shortcut icon" type="image/x-icon">
  <link href="images/webclip.png" rel="apple-touch-icon">
  <link href="css/common.css" rel="stylesheet" type="text/css">
  <style>
    .error-page-wrapper #btn-lang-ko,
    .error-page-wrapper #btn-lang-en {
      display: none !important;
      pointer-events: none;
    }
    #lang-ko-block, #lang-en-block, #lang-ko-footer, #lang-en-footer {
      display: none; /* JS will toggle visibility */
    }
    .utility-page_component {
      min-height: 60vh !important;
      height: auto !important;
      padding-top: 80px;
      padding-bottom: 80px;
      width: 100%;
    }
  </style>
</head>

<body>
  <div class="page-wrapper error-page-wrapper">
    <div id="lang-ko-block">
      {% include "header.njk" %}
    </div>
    <div id="lang-en-block">
      {% include "header-en.njk" %}
    </div>

    <!-- 404 Content -->
    <div class="utility-page_component">
      <div class="utility-page_wrapper">
        <img src="https://d3e54v103j8qbb.cloudfront.net/static/page-not-found.211a85e40c.svg" alt="" class="utility-page_image">
        <h3 id="404-title">페이지를 찾을 수 없습니다.</h3>
        <div id="404-text">요청하신 페이지가 존재하지 않거나 이동되었습니다.</div>
        <div style="margin-top:20px;">
            <a href="/" id="404-btn" class="button w-button">홈으로 돌아가기</a>
        </div>
      </div>
    </div>

    <div id="lang-ko-footer">
      {% include "footer.njk" %}
    </div>
    <div id="lang-en-footer">
      {% include "footer-en.njk" %}
    </div>
  </div>

  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=69679bea10b420b922099e64" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script src="js/webflow.js" type="text/javascript"></script>
  <script src="js/common.js" type="text/javascript"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      // 1. 사용자의 로케일/설정 언어 판별
      let userPref = localStorage.getItem('user_lang_pref');
      if (!userPref) {
        const browserLang = navigator.language || navigator.userLanguage;
        userPref = browserLang.toLowerCase().includes('ko') ? 'ko' : 'en';
      }

      // 2. DOM 엘리먼트 획득
      const koHeader = document.getElementById("lang-ko-block");
      const enHeader = document.getElementById("lang-en-block");
      const koFooter = document.getElementById("lang-ko-footer");
      const enFooter = document.getElementById("lang-en-footer");
      
      const title = document.getElementById("404-title");
      const text = document.getElementById("404-text");
      const btn = document.getElementById("404-btn");
      const htmlRoot = document.getElementById("html-root");

      // 3. 언어 설정에 따른 동적 레이아웃 변경 (404 페이지는 항상 단일 페이지로 작동해야 하므로)
      if (userPref === 'en') {
        htmlRoot.setAttribute("lang", "en-GB");
        document.title = "Not Found | Imin2UK";
        
        koHeader.style.display = "none";
        koFooter.style.display = "none";
        enHeader.style.display = "block";
        enFooter.style.display = "block";

        title.innerText = "Page Not Found";
        text.innerText = "The page you are looking for doesn't exist or has been moved.";
        btn.innerText = "Go Home";
        btn.href = "/home-en";
      } else {
        htmlRoot.setAttribute("lang", "ko-KR");
        document.title = "페이지 없음 | Imin2UK";
        
        enHeader.style.display = "none";
        enFooter.style.display = "none";
        koHeader.style.display = "block";
        koFooter.style.display = "block";

        title.innerText = "페이지를 찾을 수 없습니다.";
        text.innerText = "요청하신 페이지가 존재하지 않거나 이동되었습니다.";
        btn.innerText = "홈으로 돌아가기";
        btn.href = "/";
      }
    });
  </script>
</body>
</html>
